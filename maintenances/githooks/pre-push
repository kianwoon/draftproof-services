#!/usr/bin/env bash
#
# pre-push: two jobs (reads stdin once, used by both).
#   1. ESL FPR GATE — if a pushed commit touches poc/detect/ (the scoring code), run
#      poc/calibration/fpr_subgroup_gate.py --compare and BLOCK the push on a regression
#      (ESL false-positive rate up / AUC down / proficiency parity widened vs the committed
#      baseline). Skips gracefully (never blocks) when the local SCoCESLE corpus or the ML
#      stack is unavailable -- the corpus is local-only. Bypass: git push --no-verify
#   2. Branch reaping — when pushing the default branch, reap local branches fully merged
#      into it (mirrors the GitHub cleanup-on-push workflow). Never blocks.
#
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
#
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"
base="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')"
base="${base:-main}"

scoring_changed=0
pushing_base=0
while read -r _localref localsha remoteref remotesha; do
  [ "$remoteref" = "refs/heads/${base}" ] && pushing_base=1
  [ -z "${localsha:-}" ] && continue
  [ "$localsha" = "$ZERO" ] && continue                          # branch deletion
  if [ "$remotesha" = "$ZERO" ]; then                            # ref new on remote
    mb="$(git merge-base "$localsha" "origin/${base}" 2>/dev/null || true)"
    files="$(git diff --name-only "${mb:-${localsha}^}" "$localsha" 2>/dev/null || true)"
  else
    files="$(git diff --name-only "$remotesha" "$localsha" 2>/dev/null || true)"
  fi
  printf '%s\n' "$files" | grep -q '^poc/detect/' && scoring_changed=1
done

# --- Job 1: ESL FPR gate (may BLOCK) -----------------------------------------
if [ "$scoring_changed" = 1 ]; then
  echo "[pre-push] detection scoring (poc/detect/) changed -> ESL FPR gate."
  if ! python3 -c "import scipy, transformers, torch" >/dev/null 2>&1; then
    echo "[pre-push] ML stack unavailable -> skipping gate (run it manually before shipping). NOT blocking."
  else
    echo "[pre-push] running gate (~15-18 min, full corpus). Bypass: git push --no-verify"
    ( cd "$ROOT/poc" && TOKENIZERS_PARALLELISM=false python3 calibration/fpr_subgroup_gate.py --compare )
    rc=$?
    if [ "$rc" = 2 ]; then
      echo "[pre-push] SCoCESLE corpus unavailable (set \$SCOCESLE_CORPUS) -> skipping gate. NOT blocking."
    elif [ "$rc" != 0 ]; then
      echo "[pre-push] ESL FPR gate FAILED (regression vs baseline). Push BLOCKED."
      echo "[pre-push] If the change is intentional + re-baselined: git push --no-verify"
      exit 1
    else
      echo "[pre-push] ESL FPR gate passed."
    fi
  fi
fi

# --- Job 2: reap merged branches on push to the default branch (never blocks) -
if [ "$pushing_base" = 1 ]; then
  "$(dirname "$0")/../reap-merged-branches.sh" || true
fi
exit 0
