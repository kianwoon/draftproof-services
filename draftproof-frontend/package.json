{
  "name": "draftproof-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --config vite.ssr.config.js --outDir dist/server && node scripts/prerender-seo.mjs && node scripts/prerender-render.mjs",
    "build:deploy": "npm run build && node scripts/indexnow-ping.mjs",
    "build:client": "vite build && node scripts/prerender-seo.mjs",
    "seo:indexnow": "node scripts/indexnow-ping.mjs",
    "check:i18n": "node scripts/check-i18n-resources.mjs",
    "update:ticker": "node scripts/update-ticker-message.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "i18next": "^26.1.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.4.0"
  }
}
