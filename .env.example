# DraftProof LLM role models
# Koyeb should use Environment variables. This file is for local development.

DRAFTPROOF_PLANNER_MODEL=openai/gpt-4.1-mini
DRAFTPROOF_GENERATOR_MODEL=openai/gpt-4.1-mini
DRAFTPROOF_RETRY_MODEL=openai/gpt-4.1-mini
DRAFTPROOF_REWRITE_MODEL_LOCK=openai/gpt-4.1-mini

# Kill switch for expensive retry-model escalation.
# Keep disabled unless you deliberately want the retry model to run.
DRAFTPROOF_RETRY_MODEL_ENABLED=0
DRAFTPROOF_RETRY_MODEL_MAX_CALLS=1

# Rewrite generation sampling controls.
# OpenAI models ignore TOP_K, so the gateway strips it for openai/* models.
DRAFTPROOF_AI_SEARCH_TEMPERATURE=0.45
DRAFTPROOF_AI_SEARCH_TOP_P=0.82
DRAFTPROOF_AI_SEARCH_PRESENCE_PENALTY=0.15
DRAFTPROOF_AI_SEARCH_FREQUENCY_PENALTY=0.25

# AI-Mitigation masked-span optimizer.
# Deterministic span patches are tried first; generator fallback stays off by default
# because production cost/latency must not grow silently.
DRAFTPROOF_MASKED_SPAN_OPTIMIZER=1
DRAFTPROOF_MASKED_SPAN_CANDIDATES=3
DRAFTPROOF_MASKED_SPAN_FRESH_BASELINE=1
DRAFTPROOF_MASKED_SPAN_LLM_FALLBACK=0
DRAFTPROOF_MASKED_SPAN_SKIP_BROAD_REGEN=1

# Deterministic pruning candidates remove or compress non-essential generic
# paragraphs only when later scan gates prove the result is safer.
DRAFTPROOF_CONTENT_PRUNING_REPAIR=1
DRAFTPROOF_CONTENT_PRUNING_CANDIDATES=4
DRAFTPROOF_CONTENT_PRUNING_MIN_WORD_RATIO=0.75

# Optional public-source search for grounding-quality repair.
# Never commit a real API key here; set it in local .env or Koyeb secrets.
DRAFTPROOF_SOURCE_SEARCH_ENABLED=0
DRAFTPROOF_SOURCE_SEARCH_PROVIDER=tavily
DRAFTPROOF_SOURCE_SEARCH_MAX_QUERIES=2
DRAFTPROOF_SOURCE_SEARCH_MAX_RESULTS=3
DRAFTPROOF_SOURCE_SEARCH_MAX_CALLS_PER_RUN=5
DRAFTPROOF_SOURCE_SEARCH_MAX_CREDITS_PER_RUN=6
DRAFTPROOF_SOURCE_SEARCH_QUERY_VARIANTS=2
DRAFTPROOF_SOURCE_SEARCH_TIMEOUT=20
DRAFTPROOF_SOURCE_SEARCH_DEPTH=basic
DRAFTPROOF_TAVILY_ADVANCED_MAX_CALLS=1
DRAFTPROOF_SOURCE_SEARCH_EXCLUDE_DOMAINS=instagram.com,facebook.com,tiktok.com,x.com,twitter.com,pinterest.com,reddit.com,youtube.com,getyourteachon.com
# Optional comma-separated exact domains for narrow deployments, e.g. eric.ed.gov,oecd.org,unesco.org
DRAFTPROOF_SOURCE_SEARCH_INCLUDE_DOMAINS=
TAVILY_API_KEY=

# Block-level reinforce/remove path:
# useful weak block -> reinforce with verified public source;
# unsalvageable generic block -> prune/compress and rescan.
DRAFTPROOF_SOURCE_GROUNDING_REPAIR=1
DRAFTPROOF_SOURCE_GROUNDING_REPAIR_TARGETS=4
DRAFTPROOF_SOURCE_GROUNDING_REPAIR_CANDIDATES=2
DRAFTPROOF_SOURCE_GROUNDING_REPAIR_CONFIDENCE=strong,moderate
DRAFTPROOF_SOURCE_GROUNDING_REPAIR_TEMPERATURE=0.45

# Full document internet-reinforced reauthoring. This is the leap path:
# source-supported blocks are rebuilt; unsupported generic blocks are removed/compressed.
DRAFTPROOF_INTERNET_REINFORCED_REAUTHORING=1
DRAFTPROOF_INTERNET_REAUTHOR_CANDIDATES=2
DRAFTPROOF_INTERNET_REAUTHOR_CONFIDENCE=strong,moderate,weak
DRAFTPROOF_INTERNET_REAUTHOR_TEMPERATURE=0.52
DRAFTPROOF_INTERNET_REAUTHOR_WORD_VARIANCE=0.25

# Selector goal alignment: after hard gates, Human gain wins.
DRAFTPROOF_AI_SEARCH_ACCEPT_HUMAN_PRIMARY_PROGRESS=1
DRAFTPROOF_HUMAN_PRIMARY_MIN_GAIN=8
DRAFTPROOF_AI_SEARCH_ACCEPT_BLOCKER_ELIMINATION=1
DRAFTPROOF_BLOCKER_ELIMINATION_MIN_HUMAN_GAIN=5
DRAFTPROOF_BLOCKER_ELIMINATION_MIN_ACTIVE_DROP=20
DRAFTPROOF_BLOCKER_ELIMINATION_MAX_ACTIVE_REGRESSION=20
DRAFTPROOF_BLOCKER_ELIMINATION_REVIEW_TOLERANCE=0
DRAFTPROOF_BLOCKER_ELIMINATION_SEVERITY_TOLERANCE=0
DRAFTPROOF_BLOCKER_ELIMINATION_CRITICAL_HIGH_TOLERANCE=0
DRAFTPROOF_AI_SEARCH_MIN_CHAR_RATIO=0.60

# Targeted post-blocker repairs. These replace generic humanization.
DRAFTPROOF_CLAIM_NARROWING_REPAIR=1
DRAFTPROOF_CLAIM_NARROWING_CANDIDATES=2
DRAFTPROOF_CLAIM_NARROWING_TEMPERATURE=0.38
DRAFTPROOF_TOPK_TEXTURE_REPAIR=1
DRAFTPROOF_TOPK_TEXTURE_CANDIDATES=2
DRAFTPROOF_TOPK_TEXTURE_TEMPERATURE=0.45

# Legacy fallback used if role-specific models are not set.
LLM_MODEL=openai/gpt-4.1-mini

# OpenRouter routing. For latency-first production, do not pin provider order;
# let OpenRouter pick the currently lowest-latency provider for the fixed model.
DRAFTPROOF_OPENROUTER_PROVIDER_SORT=latency
DRAFTPROOF_OPENROUTER_ALLOW_FALLBACKS=1
DRAFTPROOF_OPENROUTER_REASONING_EFFORT=none

DRAFTPROOF_REWRITE_V3_ENABLED=0
DRAFTPROOF_REWRITE_V3_SINGLE_SHOT_WORD_LIMIT=1600
DRAFTPROOF_REWRITE_V3_CHUNK_WORD_LIMIT=900
DRAFTPROOF_REWRITE_V3_LLM_TIMEOUT_SECONDS=160
DRAFTPROOF_REWRITE_V3_RHYTHM_MIN_RATIO=0.58
DRAFTPROOF_REWRITE_V3_RHYTHM_PREFERRED_RATIO=0.68
DRAFTPROOF_REWRITE_V3_RHYTHM_MAX_RATIO=0.82
DRAFTPROOF_REWRITE_V3_RHYTHM_MIN_TOPK_DROP=8.0
DRAFTPROOF_REWRITE_V3_RHYTHM_MAX_WQ_DROP=6.0
DRAFTPROOF_REWRITE_V3_CITED_MIN_RATIO=0.60
DRAFTPROOF_REWRITE_V3_CITED_PREFERRED_RATIO=0.72
DRAFTPROOF_REWRITE_V3_CITED_MAX_RATIO=0.86
DRAFTPROOF_REWRITE_V3_STYLE_LIBRARY=
DRAFTPROOF_REWRITE_V3_CALIBRATION_STORE=
DRAFTPROOF_REWRITE_V3_COMPRESSION_TOLERANCE_RATIO=0.02
DRAFTPROOF_REWRITE_V3_MAX_INTERNAL_AI_BACKFIRE=3.0
